# Shared secret used to verify Artisia webhook signatures locally.
ARTISIA_WEBHOOK_SECRET=test-secret

# The Edge Function runs in Docker and reaches the mock through the host.
ARTISIA_BASE_URL=http://host.docker.internal:4010/v1
ARTISIA_API_KEY=test-api-key
# Server-only token used by the recovery worker. Replace outside local tests.
ARTISIA_RECOVERY_TOKEN=test-recovery-token
